# ─────────────────────────────────────────────────────────────────────────────
# env.app.template — Yorindo App (Next.js)
# Copy to yorindo-app/.env and fill in values for your environment.
#
# Usage:
#   scp env.app.template user@host:/app/yorindo-app/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-side API proxy ─────────────────────────────────────────────────────
# Next.js rewrites /api/* to this URL server-side
API_URL=http://api:3000

# ── Public base path ──────────────────────────────────────────────────────────
# Set to subdirectory if hosting at a subpath (e.g. /yorindo); leave empty for root
NEXT_PUBLIC_BASE_PATH=

# ── MSW mocks ────────────────────────────────────────────────────────────────
# Never enable in staging or production
NEXT_PUBLIC_ENABLE_MOCKS=false

# ── Telemetry ─────────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1

# ── Error monitoring (optional) ───────────────────────────────────────────────
# Client-side DSN — baked into the bundle; safe to expose publicly
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Server-side DSN — used at runtime by Node.js
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Source map upload — required only in CI builds
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
