{
  "name": "yorindo-api",
  "version": "1.0.0",
  "description": "Yorindo Event Management API",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx --watch --experimental-specifier-resolution=node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.15",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "openai": "^4.47.1",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "pino-http": "^10.2.0",
    "qrcode": "^1.5.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "@faker-js/faker": "^10.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
