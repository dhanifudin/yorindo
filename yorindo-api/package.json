{
  "name": "yorindo-api",
  "version": "1.0.0",
  "description": "EM . U Event Management API",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "lint": "npx tsc --noEmit",
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx --watch --experimental-specifier-resolution=node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:lint": "redocly lint openapi.yaml",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sentry/node": "^8.7.0",
    "bullmq": "^5.8.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "openai": "^4.52.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "typescript-json-schema": "^0.64.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.10.5",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
