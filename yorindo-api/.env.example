# ─────────────────────────────────────────────
# PHASE 1 (required for local dev — no real DB needed)
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Public base URL — used for QR code ticket links in confirmation emails
BASE_URL=http://localhost:3000

# Auth (required — used by JWT middleware)
JWT_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_xxxx

# ─────────────────────────────────────────────
# SERVICE PROVIDER CONFIGURATION
# See docs/spec-service-provider-configuration.md for full options
# ─────────────────────────────────────────────

# Repository layer: memory (Phase 1) | postgres (Phase 2)
REPOSITORY_IMPL=memory

# Email delivery: mock | brevo | mailtrap
EMAIL_PROVIDER=mock

# WhatsApp blast: mock | everpro
WHATSAPP_PROVIDER=mock

# AI provider — single toggle for ETL normalization, YoriMind analytics, and SmartFilter autocomplete
# disabled = no AI calls; all features fall back to rule-based/mock (safe default for local dev)
# mock     = returns deterministic fixture data (useful for FE dev)
# openai | anthropic = real AI (Phase 2 only; requires API key)
AI_PROVIDER=disabled

# ─────────────────────────────────────────────
# MAILTRAP (only when EMAIL_PROVIDER=mailtrap)
# ─────────────────────────────────────────────
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=
# MAILTRAP_PASS=

# ─────────────────────────────────────────────
# PHASE 2 only (leave blank or unset in Phase 1)
# ─────────────────────────────────────────────

# Databases
DATABASE_URL=postgresql://yorindo:CHANGE_ME@postgres:5432/yorindo
REDIS_URL=redis://redis:6379

# Postgres Docker service password
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars

# File storage
SNAPSHOT_DIR=/data/snapshots
UPLOADS_DIR=/tmp/uploads

# External API keys (Phase 2 real adapters only)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
BREVO_API_KEY=xsecpow...
BREVO_SENDER_EMAIL=no-reply@yorindo.app
EVERPRO_API_KEY=...

# ─────────────────────────────────────────────
# ERROR MONITORING
# ─────────────────────────────────────────────

# Sentry DSN — set to enable error monitoring; omit or leave blank to disable (safe for local dev)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
