# ─────────────────────────────────────────────
# EM · U — API Environment Variables
# Copy to yorindo-api/.env for local development
# or production deployment.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (required) ─────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_xxxx

# ── Database ────────────────────────────────
# Postgres (individual params)
REPOSITORY_IMPL=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yorindo
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars
POSTGRES_DB=yorindo

# Redis
REDIS_URL=redis://localhost:6379

# ── Service Providers ───────────────────────
# Email: Configured via Settings UI (DB-driven), not env vars
# WhatsApp: mock | everpro
WHATSAPP_PROVIDER=mock
EVERPRO_API_KEY=

# ── Base URL ────────────────────────────────
BASE_URL=http://localhost:3000
