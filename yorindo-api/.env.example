# Database
DATABASE_URL=postgresql://yorindo:CHANGE_ME@postgres:5432/yorindo
MONGODB_URL=mongodb://mongodb:27017/yorindo
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_different

# Server
PORT=3000
NODE_ENV=production
SNAPSHOT_DIR=/data/snapshots

# Third-party APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
BREVO_API_KEY=xsecpow...
EVERPRO_API_KEY=...

# Postgres (used by postgres service in docker-compose.yml)
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars
