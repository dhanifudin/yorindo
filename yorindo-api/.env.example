# ─────────────────────────────────────────────
# EM · U — API Environment Variables
# Copy to yorindo-api/.env for local development
# or production deployment.
# ─────────────────────────────────────────────

# ── Server ──────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth (required) ─────────────────────────
# Minimum 32 characters each
JWT_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_xxxx

# ── Database ────────────────────────────────
# Repository: 'memory' (dev) | 'postgres' (prod)
REPOSITORY_IMPL=postgres

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=yorindo
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars
POSTGRES_DB=yorindo

# Redis (required for ETL queue + blast)
REDIS_URL=redis://localhost:6379

# ── Service Providers ───────────────────────
# Service layer: 'mock' (dev) | 'real' (prod)
SERVICE_IMPL=mock

# Email: Configured via Settings UI (DB-driven)
# Options: mock | brevo | smtp
EMAIL_PROVIDER=mock

# WhatsApp: 'mock' (dev) | 'everpro' (prod)
WHATSAPP_PROVIDER=mock
EVERPRO_API_KEY=

# ── External API Keys (optional) ────────────
OPENAI_API_KEY=
BREVO_API_KEY=

# ── Error Monitoring (optional) ─────────────
SENTRY_DSN=

# ── Base URL ────────────────────────────────
BASE_URL=http://localhost:3000
