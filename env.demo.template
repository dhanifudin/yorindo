# ─────────────────────────────────────────────────────────────────────────────
# env.demo.template — Yorindo Demo Environment
# Loaded by docker-compose.yml via env_file or shell export.
# Place at repo root on the demo server as .env
#
# Usage:
#   scp env.demo.template user@host:/app/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars

# ── API ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_xxxx
REPOSITORY_IMPL=postgres
BASE_URL=https://demo.yorindo.app
CORS_ORIGIN=https://demo.yorindo.app

# AI: disabled | mock | openai | anthropic
AI_PROVIDER=disabled
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Email: mock | brevo
EMAIL_PROVIDER=mock
# BREVO_API_KEY=xsecpow...
# BREVO_SENDER_EMAIL=no-reply@yorindo.app

# WhatsApp: mock | everpro
WHATSAPP_PROVIDER=mock
# EVERPRO_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_MOCKS=false

# ── Error monitoring (optional) ───────────────────────────────────────────────
# APP_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
