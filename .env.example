# Runtime
NODE_ENV=production
PORT=3000
NGINX_PORT=8080

# Docker image tag — injected automatically by CD (do NOT set in VPS_ENV_FILE)
# IMAGE_TAG=v1.0.0

# Auth - required
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_at_least_32_chars

# Phase 1 adapters
REPOSITORY_IMPL=memory
SERVICE_IMPL=mock
ETL_AI_PROVIDER=mock
YORIMIND_AI_PROVIDER=mock
SMART_FILTER_AI_PROVIDER=mock

# Frontend flags
NEXT_PUBLIC_ENABLE_EXPERIMENTAL=false
NEXT_PUBLIC_ENABLE_MOCKS=false
NEXT_PUBLIC_BASE_PATH=

# Phase 2 placeholders - leave blank for now
# DATABASE_URL and REDIS_URL are constructed inside docker-compose.yml
POSTGRES_PASSWORD=

# External integrations - leave blank in Phase 1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
EVERPRO_API_KEY=

# Error monitoring — set to enable Sentry; leave blank to disable
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
