# ─────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NGINX_PORT=8080

# Docker image tag — injected automatically by CD (do NOT set in VPS_ENV_FILE)
# IMAGE_TAG=v1.0.0

# ─────────────────────────────────────────────
# Auth (required)
# ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_at_least_32_chars

# ─────────────────────────────────────────────
# Service provider configuration (Phase 1 defaults — all mock/in-memory)
# See yorindo-api/.env.example for full options per provider
# ─────────────────────────────────────────────
REPOSITORY_IMPL=memory
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
AI_PROVIDER=disabled

# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_MOCKS=false
NEXT_PUBLIC_BASE_PATH=

# ─────────────────────────────────────────────
# Phase 2 placeholders — leave blank for now
# DATABASE_URL and REDIS_URL are constructed inside docker-compose.yml
# ─────────────────────────────────────────────
POSTGRES_PASSWORD=

# External integrations — leave blank in Phase 1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BREVO_API_KEY=
MAILTRAP_API_KEY=
BREVO_SENDER_EMAIL=
EVERPRO_API_KEY=

# ─────────────────────────────────────────────
# Error monitoring — two separate Sentry projects (one per service)
# Set to enable; leave blank to disable (safe for local dev)
# ─────────────────────────────────────────────
API_SENTRY_DSN=
APP_SENTRY_DSN=
