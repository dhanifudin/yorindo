# ─────────────────────────────────────────────
# EM · U — Deployment Environment Variables
# Place at repo root on the VPS as .env
# All values below are required for production.
# ─────────────────────────────────────────────

# ── Auth (required) ─────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Image tag — injected by CD ──────────────
# IMAGE_TAG=v1.0.0

# ── Email (required) ────────────────────────
EMAIL_PROVIDER=mailtrap
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# ── WhatsApp ────────────────────────────────
WHATSAPP_PROVIDER=mock
EVERPRO_API_KEY=

# ── AI ──────────────────────────────────────
AI_PROVIDER=disabled
OPENAI_API_KEY=

# ── App ─────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ENABLE_MOCKS=false
