# ─────────────────────────────────────────────
# EM · U — Deployment Environment Variables
# Place at repo root on the VPS as .env
# All values below are required for production.
# ─────────────────────────────────────────────

# ── Auth (required) ─────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Image tag — injected by CD ──────────────
# IMAGE_TAG=v1.0.0

# ── WhatsApp ────────────────────────────────
WHATSAPP_PROVIDER=mock
EVERPRO_API_KEY=

# ── App ─────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=
