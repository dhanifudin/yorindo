# ─────────────────────────────────────────────
# EM · U — App Environment Variables
# Copy to yorindo-app/.env.local for local dev.
# ─────────────────────────────────────────────

# ── API Proxy ───────────────────────────────
# Next.js rewrites /api/* to this URL server-side
API_URL=http://localhost:3000

# ── Mock Data (development only) ────────────
# Set to 'true' to use MSW mock handlers
NEXT_PUBLIC_ENABLE_MOCKS=

# ── Public ──────────────────────────────────
NEXT_PUBLIC_BASE_PATH=
