# ─────────────────────────────────────────────
# EM · U — App Environment Variables
# Copy to yorindo-app/.env.local for local dev.
# ─────────────────────────────────────────────

# ── API Proxy ───────────────────────────────
# Next.js rewrites /api/* to this URL server-side
API_URL=http://localhost:3000

# ── Public ──────────────────────────────────
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_ENABLE_MOCKS=false
