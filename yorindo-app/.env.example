# ─────────────────────────────────────────────
# App environment variables
# Copy to .env.local for local development
# ─────────────────────────────────────────────

# Base path — set to subdirectory if hosting at a path (e.g. /yorindo)
# Leave empty for root hosting
NEXT_PUBLIC_BASE_PATH=

# MSW mocks — enable browser-side mock service worker in development
# Set to 'true' only in local dev; never in staging/production
NEXT_PUBLIC_ENABLE_MOCKS=true

# ─────────────────────────────────────────────
# EXPERIMENTAL FEATURES (disabled by default)
# ─────────────────────────────────────────────

# Participant SSO login — shows "Masuk sebagai Peserta (Google)" on the login page
# Disabled by default in all deployments until real Google OAuth is wired up (Phase 2)
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL=true
