# ─────────────────────────────────────────────
# App environment variables
# Copy to .env.local for local development
# ─────────────────────────────────────────────

# Base path — set to subdirectory if hosting at a path (e.g. /yorindo)
# Leave empty for root hosting
NEXT_PUBLIC_BASE_PATH=

# MSW mocks — enable browser-side mock service worker in development
# Set to 'true' only in local dev; never in staging/production
NEXT_PUBLIC_ENABLE_MOCKS=true

# ─────────────────────────────────────────────
# SENTRY ERROR MONITORING (optional)
# ─────────────────────────────────────────────

# Client-side DSN — baked into the bundle at build time; safe to expose publicly
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Server-side DSN — used at runtime by Node.js and Edge runtimes (same project as above)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Source map upload — required only for CI builds; not needed for local dev
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
