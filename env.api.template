# ─────────────────────────────────────────────────────────────────────────────
# env.api.template — Yorindo API (Fastify)
# Copy to yorindo-api/.env and fill in values for your environment.
#
# Usage:
#   scp env.api.template user@host:/app/yorindo-api/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BASE_URL=https://api.yorindo.app
LOG_LEVEL=info

# ── Auth (required — change both secrets before deploying) ───────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_xxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars_xxxx

# ── Database ──────────────────────────────────────────────────────────────────
REPOSITORY_IMPL=postgres
DATABASE_URL=postgresql://yorindo:CHANGE_ME_min_16_chars@postgres:5432/yorindo
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=CHANGE_ME_min_16_chars

# ── Service providers ─────────────────────────────────────────────────────────
# Email: mock | brevo | mailtrap
EMAIL_PROVIDER=brevo
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_SENDER_EMAIL=no-reply@yorindo.app

# WhatsApp: mock | everpro
WHATSAPP_PROVIDER=mock
EVERPRO_API_KEY=CHANGE_ME_EVERPRO_API_KEY

# AI: disabled | mock | openai | anthropic
AI_PROVIDER=disabled
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# ── Storage ───────────────────────────────────────────────────────────────────
SNAPSHOT_DIR=/data/snapshots
UPLOADS_DIR=/data/uploads

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://yorindo.app

# ── Error monitoring (optional) ───────────────────────────────────────────────
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
